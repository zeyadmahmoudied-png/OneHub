generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String         @id @default(uuid())
  email            String         @unique
  passwordHash     String         @map("password_hash")
  displayName      String         @map("display_name")
  preferredLocale  String         @default("ar") @map("preferred_locale")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  refreshTokens    RefreshToken[]
  integrationLogs  IntegrationLog[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model App {
  id             String   @id @default(uuid())
  appId          String   @unique @map("app_id")
  displayNameEn  String   @map("display_name_en")
  displayNameAr  String   @map("display_name_ar")
  descriptionEn  String?  @map("description_en")
  descriptionAr  String?  @map("description_ar")
  packageName    String?  @map("package_name")
  webUrl         String?  @map("web_url")
  iconUrl        String?  @map("icon_url")
  capabilities   Json     @default("[]")
  adapterType    String   @default("intent") @map("adapter_type")
  status         String   @default("planned")
  currentVersion String?  @map("current_version")
  healthScore    Int      @default(0) @map("health_score")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  versions       AppVersion[]

  @@map("apps")
}

model AppVersion {
  id          String   @id @default(uuid())
  appId       String   @map("app_id")
  version     String
  changelog   String?
  releasedAt  DateTime @default(now()) @map("released_at")
  artifactUrl String?  @map("artifact_url")
  app         App      @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@map("app_versions")
}

model IntegrationLog {
  id          String   @id @default(uuid())
  sourceAppId String   @map("source_app_id")
  targetAppId String   @map("target_app_id")
  action      String
  userId      String?  @map("user_id")
  status      String
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")
  user        User?    @relation(fields: [userId], references: [id])

  @@map("integration_logs")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  action    String
  resource  String?
  ip        String?
  userAgent String?  @map("user_agent")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}
