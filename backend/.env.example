# Copy to .env and fill real values. Never commit .env
# Matches docker-compose.yml defaults for local dev.

NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL="postgresql://onehub:onehub_dev_password@localhost:5432/onehub?schema=public"

# JWT — use long random strings in any non-local environment (≥32 chars each)
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars!!"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars!"
JWT_REFRESH_DAYS=30

# Comma-separated browser origins allowed to call the API
CORS_ORIGIN="http://localhost:3001"

# Production notes:
# - NODE_ENV=production requires real JWT secrets (no dev fallback)
# - Run: npx prisma migrate deploy && npm run start:prod
# - Health: GET /health  Readiness: GET /health/ready
# - Image: docker build -t onehub-api ./backend
